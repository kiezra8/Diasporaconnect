generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  BOARD_MEMBER
  SECRETARY
  ACCOUNTANT
  MEMBER
  FARM_WORKER
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum TransactionStatus {
  PENDING_VERIFICATION
  VERIFIED_ACCOUNTANT
  AUTHORIZED_ADMIN
  POSTED
  REJECTED
}

enum PaymentMethod {
  MTN_MOBILE_MONEY
  AIRTEL_MONEY
  BANK_WIRE
  CASH
  CHEQUE
}

enum ProjectType {
  DAIRY_CATTLE
  BEEF_CATTLE
  COFFEE_FARMING
  COFFEE_TRADING
  AGRO_FORESTRY
}

enum ProjectStatus {
  OPEN
  ACTIVE
  COMPLETED
  SUSPENDED
}

enum CattleStage {
  CALF
  HEIFER
  IN_CALF
  MILKING
  BULL
  MONEY_MAKER
}

enum CattleHealthStatus {
  HEALTHY
  SICK
  QUARANTINE
  SOLD
  DECEASED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─────────────────────────────────────────────
// USER & AUTHENTICATION
// ─────────────────────────────────────────────

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  fullName          String
  phone             String?
  role              UserRole     @default(MEMBER)
  status            UserStatus   @default(ACTIVE)
  isMfaEnabled      Boolean      @default(false)
  mfaSecret         String?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  refreshTokens     RefreshToken[]
  memberProfile     MemberProfile?
  auditLogsInitiated AuditLog[]  @relation("ActorAuditLogs")
  
  // Relations to operational activities
  verifiedTransactions SavingsTransaction[] @relation("VerifiedByAccountant")
  authorizedTransactions SavingsTransaction[] @relation("AuthorizedByAdmin")
  journalEntriesCreated JournalEntry[] @relation("CreatedJournalEntries")
  assignedTickets    SupportTicket[] @relation("AssignedStaffTickets")
  recordedMilkLogs   MilkProductionLog[]
  recordedCoffeePurchases CoffeePurchase[]

  notifications      Notification[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action      String
  entity      String
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

// ─────────────────────────────────────────────
// DOUBLE-ENTRY ACCOUNTING ENGINE
// ─────────────────────────────────────────────

model Account {
  id           String          @id @default(uuid())
  code         String          @unique // e.g., '1010' for Operating Cash
  name         String
  category     AccountCategory
  currency     String          @default("UGX")
  description  String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  journalLines JournalLine[]
}

model JournalEntry {
  id             String         @id @default(uuid())
  entryNumber    String         @unique // e.g., 'JE-2026-0001'
  date           DateTime       @default(now())
  reference      String?        // External voucher or receipt ref
  description    String
  status         JournalStatus  @default(DRAFT)
  createdById    String
  createdBy      User           @relation("CreatedJournalEntries", fields: [createdById], references: [id])
  postedAt       DateTime?
  reversalOfId   String?        @unique
  reversalOf     JournalEntry?  @relation("ReversalEntry", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry?  @relation("ReversalEntry")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines          JournalLine[]
  transactions   SavingsTransaction[]
  distributions  ProjectDistribution[]
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0.00) @db.Decimal(18, 2)
  credit         Decimal      @default(0.00) @db.Decimal(18, 2)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
}

// ─────────────────────────────────────────────
// SACCO MANAGEMENT ENGINE
// ─────────────────────────────────────────────

model MemberProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberNumber       String              @unique // e.g., 'DC-MBR-00104'
  ninOrPassport      String?
  nationalIdDocUrl   String?
  proofOfAddressUrl  String?
  countryOfResidence String              @default("Uganda")
  chapter            String              @default("Kampala")
  joinDate           DateTime            @default(now())

  savingsAccounts    SavingsAccount[]
  shareHoldings      ShareOwnership[]
  loans              LoanApplication[]
  guaranteedLoans    LoanGuarantor[]
  investments        ProjectContribution[]
  supportTickets     SupportTicket[]
}

model SavingsAccount {
  id           String               @id @default(uuid())
  memberId     String
  member       MemberProfile        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  accountNumber String              @unique
  accountType  String               @default("REGULAR_SAVINGS")
  balanceUGX   Decimal              @default(0.00) @db.Decimal(18, 2)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())

  transactions SavingsTransaction[]
}

model SavingsTransaction {
  id                  String             @id @default(uuid())
  savingsAccountId    String
  savingsAccount      SavingsAccount     @relation(fields: [savingsAccountId], references: [id])
  type                String             // 'DEPOSIT' | 'WITHDRAWAL' | 'DIVIDEND' | 'INTEREST'
  amount              Decimal            @db.Decimal(18, 2)
  currency            String             @default("UGX")
  exchangeRate        Decimal            @default(1.0000) @db.Decimal(10, 4)
  amountUGX           Decimal            @db.Decimal(18, 2)
  paymentMethod       PaymentMethod      @default(MTN_MOBILE_MONEY)
  externalReference   String?
  receiptEvidenceUrl  String?
  payoutDestination   String?            // For withdrawals
  notes               String?
  status              TransactionStatus  @default(PENDING_VERIFICATION)
  
  // Separation of Duties
  verifiedById        String?
  verifiedBy          User?              @relation("VerifiedByAccountant", fields: [verifiedById], references: [id])
  verifiedAt          DateTime?
  authorizedById      String?
  authorizedBy        User?              @relation("AuthorizedByAdmin", fields: [authorizedById], references: [id])
  authorizedAt        DateTime?
  
  journalEntryId      String?
  journalEntry        JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  createdAt           DateTime           @default(now())

  @@index([savingsAccountId])
  @@index([status])
}

model ShareClass {
  id             String           @id @default(uuid())
  name           String           // e.g., 'Ordinary Class A'
  nominalPriceUGX Decimal         @default(250000.00) @db.Decimal(18, 2)
  minShares      Int              @default(1)
  description    String?

  holdings       ShareOwnership[]
}

model ShareOwnership {
  id                String       @id @default(uuid())
  memberId          String
  member            MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shareClassId      String
  shareClass        ShareClass   @relation(fields: [shareClassId], references: [id])
  sharesCount       Int
  totalValueUGX     Decimal      @db.Decimal(18, 2)
  certificateNumber String       @unique
  issuedAt          DateTime     @default(now())

  @@index([memberId])
}

model LoanProduct {
  id                  String            @id @default(uuid())
  name                String            // e.g. 'Dairy Farm Development Loan'
  interestRateAnnual  Decimal           @db.Decimal(5, 2) // e.g. 12.00%
  maxTenureMonths     Int               @default(24)
  requiresGuarantors  Boolean           @default(true)
  minGuarantors       Int               @default(2)

  applications        LoanApplication[]
}

model LoanApplication {
  id                 String            @id @default(uuid())
  memberId           String
  member             MemberProfile     @relation(fields: [memberId], references: [id])
  loanProductId      String
  loanProduct        LoanProduct       @relation(fields: [loanProductId], references: [id])
  principalRequested Decimal           @db.Decimal(18, 2)
  principalApproved  Decimal?          @db.Decimal(18, 2)
  tenureMonths       Int
  interestRate       Decimal           @db.Decimal(5, 2)
  purpose            String
  status             String            @default("SUBMITTED") // SUBMITTED, VERIFIED, AUTHORIZED, DISBURSED, CLOSED, REJECTED
  appliedAt          DateTime          @default(now())
  disbursedAt        DateTime?

  guarantors         LoanGuarantor[]
  schedule           LoanRepaymentSchedule[]
}

model LoanGuarantor {
  id                String          @id @default(uuid())
  loanId            String
  loan              LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  guarantorMemberId String
  guarantor         MemberProfile   @relation(fields: [guarantorMemberId], references: [id])
  guaranteedAmount  Decimal         @db.Decimal(18, 2)
  status            String          @default("ACCEPTED")
}

model LoanRepaymentSchedule {
  id             String          @id @default(uuid())
  loanId         String
  loan           LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNum Int
  dueDate        DateTime
  principalDue   Decimal         @db.Decimal(18, 2)
  interestDue    Decimal         @db.Decimal(18, 2)
  totalDue       Decimal         @db.Decimal(18, 2)
  amountPaid     Decimal         @default(0.00) @db.Decimal(18, 2)
  paidAt         DateTime?
  status         String          @default("PENDING") // PENDING, PAID, OVERDUE
}

// ─────────────────────────────────────────────
// AGRICULTURAL INVESTMENT ENGINE
// ─────────────────────────────────────────────

model InvestmentProject {
  id                 String                @id @default(uuid())
  code               String                @unique // e.g., 'PRJ-DAIRY-01'
  name               String
  type               ProjectType
  description        String
  openingDate        DateTime
  closingDate        DateTime?
  targetCapitalUGX   Decimal               @db.Decimal(18, 2)
  actualCapitalUGX   Decimal               @default(0.00) @db.Decimal(18, 2)
  unitCostUGX        Decimal               @db.Decimal(18, 2) // e.g. 8,000,000 UGX for 2 Cows Money Maker
  projectedRoiText   String?               // e.g., "18% - 24% annual historical dairy yield (non-guaranteed)"
  status             ProjectStatus         @default(OPEN)
  createdAt          DateTime              @default(now())

  contributions      ProjectContribution[]
  distributions      ProjectDistribution[]
  cattle             Cattle[]
}

model ProjectContribution {
  id                String            @id @default(uuid())
  memberId          String
  member            MemberProfile     @relation(fields: [memberId], references: [id])
  projectId         String
  project           InvestmentProject @relation(fields: [projectId], references: [id])
  unitsCount        Int               @default(1)
  amountInvestedUGX Decimal           @db.Decimal(18, 2)
  status            TransactionStatus @default(PENDING_VERIFICATION)
  certificateRef    String?
  createdAt         DateTime          @default(now())

  @@index([memberId])
  @@index([projectId])
}

model ProjectDistribution {
  id               String            @id @default(uuid())
  projectId        String
  project          InvestmentProject @relation(fields: [projectId], references: [id])
  date             DateTime          @default(now())
  totalPoolUGX     Decimal           @db.Decimal(18, 2)
  description      String
  journalEntryId   String?
  journalEntry     JournalEntry?     @relation(fields: [journalEntryId], references: [id])
}

// ─────────────────────────────────────────────
// CATTLE & FARM MANAGEMENT ENGINE
// ─────────────────────────────────────────────

model Farm {
  id            String   @id @default(uuid())
  name          String   // e.g. 'Luwero Commercial Dairy Farm'
  district      String   @default("Luwero")
  acreage       Decimal  @db.Decimal(8, 2)
  
  cattle        Cattle[]
  milkLogs      MilkProductionLog[]
  feedStock     FarmFeedInventory[]
}

model Cattle {
  id                String              @id @default(uuid())
  tagNumber         String              @unique // e.g., 'DC-COW-042'
  qrCode            String              @unique
  name              String?
  breed             String              // 'Friesian Purebred', 'Jersey', 'Fleckvieh'
  sex               String              @default("Female")
  dob               DateTime?
  acquisitionDate   DateTime            @default(now())
  acquisitionCostUGX Decimal            @default(4000000.00) @db.Decimal(18, 2)
  farmId            String
  farm              Farm                @relation(fields: [farmId], references: [id])
  projectId         String?
  project           InvestmentProject?  @relation(fields: [projectId], references: [id])
  stage             CattleStage         @default(MILKING)
  healthStatus      CattleHealthStatus  @default(HEALTHY)
  paddockNumber     String?

  healthRecords     CattleHealthRecord[]
  breedingRecords   CattleBreedingRecord[]
  createdAt         DateTime            @default(now())

  @@index([farmId])
  @@index([tagNumber])
}

model MilkProductionLog {
  id                   String   @id @default(uuid())
  farmId               String
  farm                 Farm     @relation(fields: [farmId], references: [id])
  date                 DateTime @default(now())
  morningLiters        Decimal  @db.Decimal(10, 2)
  afternoonLiters      Decimal  @default(0.00) @db.Decimal(10, 2)
  eveningLiters        Decimal  @db.Decimal(10, 2)
  totalLiters          Decimal  @db.Decimal(10, 2)
  chillingTempCelsius  Decimal  @default(3.8) @db.Decimal(4, 1)
  offTakerName         String   @default("Brookside Dairy Uganda")
  ratePerLiterUGX      Decimal  @default(1650.00) @db.Decimal(10, 2)
  totalRevenueUGX      Decimal  @db.Decimal(18, 2)
  recordedById         String
  recordedBy           User     @relation(fields: [recordedById], references: [id])
  createdAt            DateTime @default(now())

  @@index([farmId, date])
}

model CattleHealthRecord {
  id                     String   @id @default(uuid())
  cattleId               String
  cattle                 Cattle   @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  eventType              String   // 'VACCINATION', 'TREATMENT', 'DEWORMING'
  conditionOrVaccine     String   // 'Foot and Mouth Disease (FMD)', 'ECF', 'Mastitis'
  drugAdministered       String?
  dosage                 String?
  withdrawalPeriodDays   Int      @default(0)
  dateAdministered       DateTime @default(now())
  notes                  String?
}

model CattleBreedingRecord {
  id                  String    @id @default(uuid())
  cattleId            String
  cattle              Cattle    @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  inseminationDate    DateTime
  sireBreedOrStraw    String    // 'ABS Global Genus Friesian 29HO'
  technicianName      String?
  expectedCalvingDate DateTime?
  actualCalvingDate   DateTime?
  calfTagNumber       String?
  notes               String?
}

model FarmFeedInventory {
  id                   String   @id @default(uuid())
  farmId               String
  farm                 Farm     @relation(fields: [farmId], references: [id])
  feedType             String   // 'Silage Bunker 1', 'Rhodes Grass Hay', 'Dairy Concentrates'
  quantityKg           Decimal  @db.Decimal(12, 2)
  minimumThresholdKg   Decimal  @db.Decimal(12, 2)
  lastRestockedAt      DateTime @default(now())
}

// ─────────────────────────────────────────────
// COFFEE MANAGEMENT SYSTEM
// ─────────────────────────────────────────────

model CoffeeSupplier {
  id          String           @id @default(uuid())
  code        String           @unique // e.g., 'SUP-BGS-019'
  fullName    String
  phone       String
  district    String           // 'Bugisu - Mbale', 'Rwenzori - Kasese'
  purchases   CoffeePurchase[]
}

model CoffeePurchase {
  id                     String         @id @default(uuid())
  batchNumber            String         @unique // e.g., 'BATCH-CF-2026-004'
  supplierId             String
  supplier               CoffeeSupplier @relation(fields: [supplierId], references: [id])
  coffeeType             String         // 'Arabica Bugisu AA', 'Robusta Screen 18'
  grade                  String         @default("AA")
  weightKg               Decimal        @db.Decimal(10, 2)
  moistureContentPercent Decimal        @db.Decimal(4, 2) // e.g. 12.5%
  pricePerKgUGX          Decimal        @db.Decimal(10, 2)
  totalAmountUGX         Decimal        @db.Decimal(18, 2)
  paymentReference       String?
  recordedById           String
  recordedBy             User           @relation(fields: [recordedById], references: [id])
  date                   DateTime       @default(now())

  @@index([supplierId])
}

model CoffeeInventory {
  id                     String   @id @default(uuid())
  warehouseLocation      String   @default("Kampala Central Hub")
  coffeeType             String   @unique
  currentStockKg         Decimal  @default(0.00) @db.Decimal(12, 2)
  totalProcessedKg       Decimal  @default(0.00) @db.Decimal(12, 2)
  processingLossKg       Decimal  @default(0.00) @db.Decimal(12, 2)
  lastAuditDate          DateTime @default(now())
}

model CoffeeSale {
  id                     String   @id @default(uuid())
  salesOrderNumber       String   @unique // e.g., 'SO-EXP-2026-002'
  buyerName              String   // e.g., 'Hamburg Coffee Company GmbH'
  destinationCountry     String   @default("Germany")
  coffeeType             String
  grade                  String
  weightSoldKg           Decimal  @db.Decimal(10, 2)
  pricePerKgUSD          Decimal  @db.Decimal(8, 2)
  exchangeRate           Decimal  @default(3800.00) @db.Decimal(10, 2)
  totalAmountUGX         Decimal  @db.Decimal(18, 2)
  paymentStatus          String   @default("PAID")
  date                   DateTime @default(now())
}

// ─────────────────────────────────────────────
// CUSTOMER SUPPORT & TICKETS (RAG READY)
// ─────────────────────────────────────────────

model SupportTicket {
  id              String           @id @default(uuid())
  ticketNumber    String           @unique // e.g., 'TKT-2026-012'
  memberId        String
  member          MemberProfile    @relation(fields: [memberId], references: [id])
  subject         String
  category        String           // 'Shares', 'Savings', 'Farm Investment', 'Account'
  priority        Priority         @default(MEDIUM)
  status          TicketStatus     @default(OPEN)
  assignedStaffId String?
  assignedStaff   User?            @relation("AssignedStaffTickets", fields: [assignedStaffId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  messages        SupportMessage[]
}

model SupportMessage {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  message       String
  isInternalNote Boolean      @default(false)
  createdAt     DateTime      @default(now())
}

model KnowledgeBaseArticle {
  id            String   @id @default(uuid())
  title         String
  category      String   // 'SACCO Policies', 'Dairy Cattle Terms', 'Shares', 'Withdrawals'
  content       String
  tags          String[]
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   // 'DEPOSIT_SUBMITTED', 'VERIFICATION_REQUIRED', 'TRANSACTION_AUTHORIZED'
  isRead      Boolean  @default(false)
  linkUrl     String?
  createdAt   DateTime @default(now())

  @@index([recipientId, isRead])
}

