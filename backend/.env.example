# ─── Diaspora Connect API — environment (copy to backend/.env on the VPS; never commit .env) ───

# Supabase → Project Settings → API
SUPABASE_URL="https://cbohtkesgaxuixbdsucw.supabase.co"
# The service_role key (secret — server only, never put it in the portal build)
SUPABASE_SERVICE_ROLE_KEY=""

# Comma-separated origins allowed to call the API
CORS_ORIGINS="https://diasporaconnectt.com,https://www.diasporaconnectt.com"

# ─── MTN MoMo — Collection product (https://momodeveloper.mtn.com) ───
MTN_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_TARGET_ENVIRONMENT="sandbox"          # production: the value MTN Uganda issues with your live keys
MTN_CURRENCY="EUR"                         # sandbox uses EUR; production UGX
MTN_COLLECTION_SUBSCRIPTION_KEY=""
MTN_API_USER=""
MTN_API_KEY=""
MTN_CALLBACK_URL="https://api.diasporaconnectt.com/payments/mtn/callback"

# ─── Airtel Money — Collection API (https://developers.airtel.africa) ───
AIRTEL_BASE_URL="https://openapiuat.airtel.africa"   # production: https://openapi.airtel.africa
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
AIRTEL_COUNTRY="UG"
AIRTEL_CURRENCY="UGX"
# Callback URL to register in the Airtel portal: https://api.diasporaconnectt.com/payments/airtel/callback

# ─── SMS — Africa's Talking (https://africastalking.com) ───
AT_USERNAME="sandbox"     # your app username in production
AT_API_KEY=""
AT_SENDER_ID=""           # approved alphanumeric sender id (production only)

# ─── AI advisor ───
ANTHROPIC_API_KEY=""
