# ==============================================================================
# DIASPORA CONNECT FARMERS SACCO - PRODUCTION SECURITY & SERVER HARDENING
# ==============================================================================

# 1. PREVENT DIRECTORY BROWSING
Options -Indexes

# 2. BLOCK ACCESS TO SENSITIVE HIDDEN FILES & DIRECTORIES
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|env|git.*))$">
    Require all denied
</FilesMatch>

# 3. HTTP SECURITY HEADERS (DEFENSE-IN-DEPTH)
<IfModule mod_headers.c>
    # Content Security Policy (Zero-Trust Script & Embed Execution)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"

    # Anti-Clickjacking Defense
    Header always set X-Frame-Options "DENY"

    # Block MIME-Type Sniffing Attacks
    Header always set X-Content-Type-Options "nosniff"

    # Referrer Information Protection
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict Browser Hardware & Sensor APIs
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # HTTP Strict Transport Security (HSTS - 1 Year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Cross-Site Scripting (XSS) Legacy Protection
    Header always set X-XSS-Protection "1; mode=block"

    # Cross-Origin Policies
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# 4. BLOCK MALICIOUS URL QUERY INJECTIONS
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block query strings containing script tags or common SQL/PHP injection strings
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} (base64_encode|base64_decode) [NC,OR]
    RewriteCond %{QUERY_STRING} (concat.*\(|union.*select) [NC]
    RewriteRule .* - [F,L]
</IfModule>
